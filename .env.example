# Server-only Vercel Function settings; never copy into HTML or assets.
# Generate one random secret (>=32 characters) and set the same value on the
# website, SerosOS runtime, and its Google-auth gateway. Do not reuse EDGE_SECRET.
SEROS_WEBSITE_INGEST_SECRET=
# Optional; exact HTTPS ingestion endpoint (this is the default):
SEROS_WEBSITE_INGEST_URL=https://os.seros.dev/api/webhooks/seros-website
